fun fibo(n){
    var i = 0;
    var a = 0;
    var b = 1;
    while (i<n) {

        b = a + b;
        a = b - a;
        i = i +1
    }
    print b;
}

fun fibo2(n){
    var a = 0;
    var b = 1;
    for (var i =0; i<n; i=i+1) {
        if (b > 12){
            return b
        }
        b = a + b;
        a = b - a
    }
    print b;
}
var d = fibo2(15);

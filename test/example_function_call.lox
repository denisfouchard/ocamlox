fun fibo(n){
    print "Executing fibo";
    var i = 0;
    var a = 0;
    var b = 1;
    while (i<n) {
        print i;
        b = a + b;
        a = b - a;
        i = i +1;

    }
    print b;
}

fun fibo2(n){
    var a = 0;
    var b = 1;
    for (var i =0; i<n; i=i+1) {
        b = a + b;
        a = b - a
    }
    return b;
}

fun inplace_fibo(n, t){
    var a = 0;
    var b = 1;
    for (var i =0; i<n; i=i+1) {
        b = a + b;
        a = b - a
    }
    t = b;
}

